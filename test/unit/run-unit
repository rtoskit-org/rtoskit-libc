# Usage: run-unit <build directory of test/unit>
#
# Runs every unit test executable below the build directory. A test passes
# when it exits with status 0. When the test's source directory contains an
# executable <name>.run, that script is run with the executable's path instead
# and decides the outcome. TARGET_RUNNER (e.g. a qemu command) prefixes every
# execution. Each run is limited to 60 s, or to the seconds that a <name>.timeout
# file next to the source gives (a long accuracy sweep, PLAN D63).

build_dir=$(realpath "$1")
source_dir=${PROJECT_ROOT:?}/test/unit
passed=0
failed=0

for elf in $(find "${build_dir}" -name '*.elf' | sort); do
	name=$(basename "${elf}" .elf)
	relative=$(dirname "${elf#${build_dir}/}")
	driver=${source_dir}/${relative}/${name}.run
	log=${elf%.elf}.log
	limit=60

	if [[ -f ${source_dir}/${relative}/${name}.timeout ]]; then
		limit=$(< "${source_dir}/${relative}/${name}.timeout")
	fi

	if [[ -x ${driver} ]]; then
		TARGET_RUNNER=${TARGET_RUNNER:-} timeout ${limit} "${driver}" "${elf}" > "${log}" 2>&1
	else
		timeout ${limit} ${TARGET_RUNNER:-} "${elf}" > "${log}" 2>&1
	fi
	status=$?

	if [[ ${status} -eq 0 ]]; then
		echo "pass ${relative}/${name}"
		passed=$((passed + 1))
	else
		echo "fail ${relative}/${name} (status ${status}, log ${log})"
		sed 's/^/    /' "${log}"
		failed=$((failed + 1))
	fi
done

# A test the build could not make for this compiler leaves <name>.skip with the reason (PLAN D127)
skipped=0
for skip in $(find "${build_dir}" -name '*.skip' | sort); do
	# A test built since (a newer compiler in the same tree) ran above
	[[ -f ${skip%.skip}.elf ]] && continue
	echo "skip $(dirname "${skip#${build_dir}/}")/$(basename "${skip}" .skip): $(< "${skip}")"
	skipped=$((skipped + 1))
done

echo "unit tests: ${passed} passed, ${failed} failed$([[ ${skipped} -gt 0 ]] && echo ", ${skipped} skipped")"
[[ ${failed} -eq 0 && ${passed} -gt 0 ]]
