# Usage: flavours.run <flavours.elf>
# The flavours test linked against libc.a, then the headers: every build type installs exactly the headers of
# include/, so the fast build's are the speed build's (PLAN D162: a program cannot tell them apart by their headers).
# INSTALL_ROOT is the build type's install, exported by the top-level Makefile.

${TARGET_RUNNER:-} "$1" || exit $?
diff -r "${PROJECT_ROOT:?}/include" "${INSTALL_ROOT:?}/include" || { echo "fail: ${INSTALL_ROOT}/include differs from include/"; exit 1; }
echo "headers: ${INSTALL_ROOT}/include is include/"
