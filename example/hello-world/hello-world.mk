ifeq ($(findstring ${BUILD_ROOT},${CURDIR}),)
include ${PROJECT_ROOT}/tools/makefiles/target.mk
else

EXTRA_DEPS := ${SOURCE_DIR}/hello-world.mk
EXTRA_ELF_DEPS := ${BUILD_ROOT}/libc/libc.a

TARGET_OBJ_LIBS := port/${RTOS_PORT} port/${RTOS_PORT}/${ARCH_FAMILY}

include ${PROJECT_ROOT}/tools/makefiles/project.mk

all: ${INSTALL_ROOT}/hello-world

${INSTALL_ROOT}/hello-world: ${CURDIR}/hello-world.elf
	@echo "INSTALLING ${@}"
	mkdir -p $(@D)
	$(INSTALL) -m 755 ${<} ${@}

endif
